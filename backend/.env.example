# ============================================================
# Variáveis de Ambiente — Backend (desenvolvimento local)
# Copie este arquivo para .env e ajuste conforme necessário:
#   cp backend/.env.example backend/.env
# ============================================================

# ─── Banco de Dados ─────────────────────────────────────────
# Connection string do PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/livros_db?schema=public"

# ─── Servidor ───────────────────────────────────────────────
PORT=8000

# URL base da API (usada para montar as URLs de imagens de capa)
APP_URL=http://localhost:8000
